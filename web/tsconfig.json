{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@ui/*": ["../ui/src/*"],
      "@shared/*": ["../src/shared/*"]
    }
  },
  "include": ["src", "vite.config.ts", "../ui/src", "../src/shared/**/*.ts", "../src/domain/model.ts"]
}
