# CareCompanion — environment variables.
# Names + safe defaults only. Never commit a real .env; secrets live in Render's dashboard or your local AWS profile.

# --- server ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
# Comma-separated Host headers accepted by the MCP endpoint (DNS-rebinding protection).
# On Render, RENDER_EXTERNAL_HOSTNAME is appended automatically.
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated browser origins allowed by CORS, or * for any (demo default).
CORS_ORIGINS=*

# --- MCP authentication (optional; Alexa+ Tier-1 service-level auth) ---
# none                = open endpoint (the public demo)
# client_credentials  = /oauth/token issues short-lived Bearer tokens (client_credentials grant, HTTP Basic client
#                       auth) and /mcp requires them; discovery at /.well-known/oauth-authorization-server and
#                       /.well-known/oauth-protected-resource/mcp
MCP_AUTH=none
# MCP_CLIENT_ID=alexa-addon
# MCP_CLIENT_SECRET=change-me-to-a-long-random-string
MCP_TOKEN_TTL_SEC=3600
# Public base URL (OAuth issuer + the `resource` of /mcp). Derived from RENDER_EXTERNAL_HOSTNAME on Render.
# PUBLIC_URL=https://carecompanion.example.com

# --- household data ---
HOUSEHOLD_TZ=America/Los_Angeles
# always | if-empty | never  (Render's disk is ephemeral, so production uses `always`)
SEED_ON_BOOT=if-empty
DATA_FILE=./data/state.json

# --- Bedrock (AWS Builder mini) ---
# The local ~/.aws default profile is ap-south-1 — always pin the Bedrock region explicitly.
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# AWS_PROFILE=default                # local only; on Render set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY as secrets
AGENT_BRAIN=bedrock                  # bedrock | rules  (rules = offline intent router, no AWS needed)
AGENT_MAX_TOOL_ROUNDS=5
AGENT_MAX_TOKENS=768
AGENT_DAILY_TURN_CAP=400
AGENT_RATE_PER_MIN=10

# --- demo controls ---
DEMO_RESET_TOKEN=change-me           # x-demo-token header for POST /api/demo/reset
DEMO_CLOCK_OFFSET_MIN=0              # shifts "now" for reproducible demos
RING_ENABLED=false
